FROM nvcr.io/nvidia/pytorch:25.04-py3

ENV NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute
ENV DEBIAN_FRONTEND=noninteractive

# ── System deps ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential yasm cmake libtool git pkg-config \
    libass-dev libfreetype6-dev libvorbis-dev \
    autoconf automake texinfo tmux ffmpeg libegl1 \
    && rm -rf /var/lib/apt/lists/*

# ── Python tooling ──────────────────────────────────────────────────────
RUN pip install --upgrade pip setuptools wheel && pip install uv

# Fix NVIDIA container pip constraints that conflict with our deps
RUN sed -i s/dill==0.3.9/dill==0.3.8/g /etc/pip/constraint.txt 2>/dev/null || true && \
    sed -i s/scipy==1.15.2/scipy==1.15.3/g /etc/pip/constraint.txt 2>/dev/null || true

# ── Install gr00t dependencies (frozen versions) ────────────────────────
# Core ML stack
RUN pip install --no-cache-dir \
    torch==2.7.1 torchvision==0.22.1 \
    transformers==4.51.3 \
    deepspeed==0.17.6 \
    peft==0.17.1 \
    diffusers==0.35.1 \
    accelerate==1.12.0 \
    timm==1.0.25

# flash-attn needs special build (takes ~10 min)
RUN pip install --no-cache-dir flash-attn==2.7.4.post1 --no-build-isolation

# Data / video processing
RUN pip install --no-cache-dir \
    torchcodec==0.4.0 \
    av==15.0.0 \
    datasets==3.6.0 \
    pandas==2.2.3 \
    numpy==1.26.4 \
    decord==0.6.0 \
    imageio==2.37.2 \
    imageio-ffmpeg==0.6.0 \
    lmdb==1.7.5 \
    msgpack==1.1.0 \
    msgpack-numpy==0.4.8 \
    dm-tree==0.1.8 \
    pyarrow==23.0.1

# Utilities
RUN pip install --no-cache-dir \
    tyro==0.9.17 \
    wandb==0.23.0 \
    omegaconf==2.3.0 \
    click==8.1.8 \
    albumentations==1.4.18 \
    einops==0.8.1 \
    scipy==1.15.3 \
    matplotlib==3.10.1 \
    gymnasium==1.2.2 \
    pyzmq==27.0.1 \
    termcolor==3.2.0 \
    safetensors==0.7.0 \
    rich==14.3.3 \
    opencv-python-headless==4.11.0.86 \
    scikit-image==0.25.2 \
    torchmetrics==1.8.2 \
    easydict==1.13 \
    hydra-core==1.3.2 \
    gdown==5.2.1

# ── EGL / Vulkan ────────────────────────────────────────────────────────
RUN mkdir -p /usr/share/glvnd/egl_vendor.d && \
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
    > /usr/share/glvnd/egl_vendor.d/10_nvidia.json && \
    mkdir -p /usr/share/vulkan/icd.d && \
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.2.140"}}' \
    > /usr/share/vulkan/icd.d/nvidia_icd.json

# ── Entrypoint: install gr00t editable on start ─────────────────────────
RUN printf '#!/bin/bash\nset -e\nif [ -f /workspace/gr00t/pyproject.toml ]; then\n  pip install -e /workspace/gr00t --no-deps -q 2>/dev/null || true\nfi\nexec "$@"\n' > /entrypoint.sh && \
    chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
